    <string name="guide_title_1">CamNexusRTSP</string>
    <string name="guide_sub_1">Turn your phone into a LAN RTSP camera\nStream straight to PCs, tablets and NVRs</string>

    <string name="guide_title_2">Everything at a glance</string>
    <string name="guide_item_2a">Top status bar</string>
    <string name="guide_item_2b">Shows quality, frame rate and viewer count in real time</string>
    <string name="guide_item_2c">Full-screen preview</string>
    <string name="guide_item_2d">Fills the whole screen, including the status bar and notch area</string>
    <string name="guide_item_2e">Bottom control card</string>
    <string name="guide_item_2f">Start or stop with one tap; expand to change camera, resolution, frame rate and bitrate</string>

    <string name="guide_title_3">All the essentials</string>
    <string name="guide_item_3a">H.264 / H.265 switching</string>
    <string name="guide_item_3b">H.265 is smaller at the same quality but requires player support</string>
    <string name="guide_item_3c">Runs with the screen off</string>
    <string name="guide_item_3d">Keeps streaming after the screen turns off — ideal for surveillance</string>
    <string name="guide_item_3e">Power saving</string>
    <string name="guide_item_3f">Lowers quality when nobody is watching to reduce heat and battery drain</string>
    <string name="guide_item_3g">Authentication</string>
    <string name="guide_item_3h">Default username and password are both camnexus; change them in Settings</string>

