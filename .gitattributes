# 统一换行符，避免 Windows / macOS / Linux 混合提交
* text=auto

*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.pro   text eol=lf
*.properties text eol=lf
gradlew text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf

# 二进制
*.jar   binary
*.png   binary
*.jpg   binary
*.webp  binary
*.jks   binary
