    <string name="guide_title_1">CamNexusRTSP</string>
    <string name="guide_sub_1">把手机变成局域网 RTSP 摄像头\n电脑、平板、NVR 直接拉流观看</string>

    <string name="guide_title_2">界面一目了然</string>
    <string name="guide_item_2a">顶部状态条</string>
    <string name="guide_item_2b">实时显示画质、帧率与在线客户端数</string>
    <string name="guide_item_2c">中间全屏预览</string>
    <string name="guide_item_2d">铺满整块屏幕，含状态栏与刘海区</string>
    <string name="guide_item_2e">底部控制卡片</string>
    <string name="guide_item_2f">一键开关服务，展开可调摄像头、分辨率、帧率、码率</string>

    <string name="guide_title_3">该有的功能都有</string>
    <string name="guide_item_3a">H.264 / H.265 切换</string>
    <string name="guide_item_3b">H.265 同画质体积更小，需播放器支持</string>
    <string name="guide_item_3c">锁屏常驻</string>
    <string name="guide_item_3d">息屏后继续推流，适合当监控使用</string>
    <string name="guide_item_3e">省电模式</string>
    <string name="guide_item_3f">无人观看时自动降低画质，减少发热与耗电</string>
    <string name="guide_item_3g">访问验证</string>
    <string name="guide_item_3h">默认账号密码均为 camnexus，可在设置中修改</string>

    <string name="guide_title_4">先授予必要权限</string>
    <string name="guide_sub_4">相机和麦克风是必需项，通知用于显示常驻状态。</string>
